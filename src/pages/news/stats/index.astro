---
import Layout from "@/components/layout/Layout.astro";
import { buttonVariants } from "@/components/ui/button";
import Coverage from "@/pages/news/stats/_Coverage.astro";
import { getFeedMetrics } from "@/lib/news/feeds/metrics";

export const prerender = false;

const { feeds: feedRows, totals } = await getFeedMetrics();

const formatDate = (date: Date | undefined) => date?.toISOString().slice(0, 10);

const numberFormat = Intl.NumberFormat();
---

<Layout title="Feed Statistics">
	<div class="mx-auto flex w-full max-w-6xl flex-col gap-6 p-8">
		{import.meta.env.DEV && (
			<a
				href="/api/updateAllFeeds"
				target="_blank"
				rel="noopener noreferrer"
				class={buttonVariants({ variant: "outline", className: "self-start" })}
			>
				Update posts
			</a>
		)}
		<div class="overflow-x-auto rounded-lg border">
			<table class="w-full border-collapse text-sm">
				<thead>
					<tr class="border-b">
						<th class="px-4 py-3 text-left font-medium">Feed</th>
						<th class="px-4 py-3 text-right font-medium">Posts</th>
						<th class="px-4 py-3 text-right font-medium">Newest</th>
						<th class="px-4 py-3 text-right font-medium">Oldest</th>
						<th class="px-4 py-3 text-right font-medium">Descriptions</th>
						<th class="px-4 py-3 text-right font-medium">Content</th>
						<th class="px-4 py-3 text-right font-medium">Thumbnails</th>
						<th class="px-4 py-3 text-right font-medium">Unique thumbnails</th>
						<th class="px-4 py-3 text-left font-medium">Adapter</th>
						{import.meta.env.DEV && <th class="px-4 py-3" />}
					</tr>
				</thead>
				<tbody>
					{feedRows.map(({ feed, metrics }) => (
						<tr class="hover:bg-muted border-b last:border-0">
							<td class="px-4 py-3">
								<a
									href={feed.links.overview}
									class="text-primary font-medium wrap-anywhere hyphens-auto hover:underline"
								>
									{feed.name}
								</a>
							</td>
							<td class="px-4 py-3 text-right tabular-nums">
								{numberFormat.format(metrics.posts.count)}
							</td>
							<td class="px-4 py-3 text-right whitespace-nowrap tabular-nums">
								{formatDate(metrics.posts.newest)}
							</td>
							<td class="px-4 py-3 text-right whitespace-nowrap tabular-nums">
								{formatDate(metrics.posts.oldest)}
							</td>
							<td class="px-4 py-3 text-right tabular-nums">
								<Coverage value={metrics.description.coverage} />
							</td>
							<td class="px-4 py-3 text-right tabular-nums">
								<Coverage value={metrics.content.coverage} />
							</td>
							<td class="px-4 py-3 text-right tabular-nums">
								<Coverage value={metrics.thumbnail.coverage} />
							</td>
							<td class="px-4 py-3 text-right tabular-nums">
								<Coverage value={metrics.thumbnail.uniqueCoverage} />
							</td>
							<td class="px-4 py-3">{feed.adapter}</td>
							{import.meta.env.DEV && (
								<td class="px-4 py-3">
									<a
										href={`/api/purgePosts?feed=${feed.slug}`}
										target="_blank"
										rel="noopener noreferrer"
										onclick={`return confirm("Delete every stored post for ${feed.slug}?")`}
										class={buttonVariants({
											variant: "destructive",
											size: "sm",
										})}
									>
										Purge posts
									</a>
								</td>
							)}
						</tr>
					))}
				</tbody>
				<tfoot>
					<tr class="border-t">
						<td class="px-4 py-3 font-bold">
							Total ({feedRows.length} sources):
						</td>
						<td class="px-4 py-3 text-right font-bold tabular-nums">
							{numberFormat.format(totals.posts.count)}
						</td>
						<td class="px-4 py-3 text-right font-bold whitespace-nowrap tabular-nums">
							{formatDate(totals.posts.newest)}
						</td>
						<td class="px-4 py-3 text-right font-bold whitespace-nowrap tabular-nums">
							{formatDate(totals.posts.oldest)}
						</td>
						<td class="px-4 py-3 text-right font-bold tabular-nums">
							<Coverage value={totals.description.coverage} />
						</td>
						<td class="px-4 py-3 text-right font-bold tabular-nums">
							<Coverage value={totals.content.coverage} />
						</td>
						<td class="px-4 py-3 text-right font-bold tabular-nums">
							<Coverage value={totals.thumbnail.coverage} />
						</td>
						<td class="px-4 py-3 text-right font-bold tabular-nums">
							<Coverage value={totals.thumbnail.uniqueCoverage} />
						</td>
						<td></td>
						{import.meta.env.DEV && <td />}
					</tr>
				</tfoot>
			</table>
		</div>
	</div>
</Layout>
