---
import Layout from "@/components/layout/Layout.astro";
import { PostComponent } from "@/components/react/post";
import { getFeedBySlug, isFeedSlug } from "@/lib/news/feeds/feed";
import { getFeedMetrics } from "@/lib/news/feeds/metrics";
import { rpc } from "@/rpc/client";
import {
	ArrowLeftIcon,
	ArrowRightIcon,
	ExternalLinkIcon,
	RssIcon,
} from "lucide-react";
import { Icon } from "@/components/react/icon";

export const prerender = false;

const { slug } = Astro.params;

if (!slug || !isFeedSlug(slug)) {
	return new Response(null, { status: 404 });
}

const feed = getFeedBySlug(slug);
const [{ posts: recentPosts }, { feeds: feedMetrics }] = await Promise.all([
	rpc.news.posts.query({ feeds: [slug], paginate: { maxPageSize: 10 } }),
	getFeedMetrics(),
]);

const { count, newest, oldest } = feedMetrics.find(
	(entry) => entry.feed.slug === slug,
)!.metrics.posts;

const formatDate = (date: Date) =>
	date.toLocaleDateString("en-US", {
		year: "numeric",
		month: "short",
		day: "numeric",
	});

const details = [
	`${Intl.NumberFormat().format(count)} posts`,
	newest && `Latest ${formatDate(newest)}`,
	oldest && `Since ${formatDate(oldest)}`,
].filter(Boolean);

const links = [
	{
		label: "Website",
		href: feed.links.homepage,
		icon: ExternalLinkIcon,
	},
	{ label: "RSS", href: feed.links.rss, icon: RssIcon },
	{ label: "Atom", href: feed.links.atom, icon: RssIcon },
];
---

<Layout title={feed.name}>
	<div class="mx-auto flex w-full max-w-4xl flex-col gap-8 p-8">
		<a
			href="/news/sources"
			class="text-primary flex items-center gap-2 self-start text-sm font-medium hover:underline"
		>
			<Icon icon={ArrowLeftIcon} />
			All sources
		</a>

		<div class="flex flex-col gap-4 border-b pb-8">
			<div class="flex items-center gap-4">
				<img
					src={feed.coverImageSrc}
					alt=""
					class="bg-card size-16 shrink-0 rounded-md border object-contain p-1.5"
				/>
				<h1 class="font-serif text-3xl font-bold wrap-anywhere hyphens-auto">
					{feed.name}
				</h1>
			</div>

			<p class="text-muted-foreground max-w-prose">{feed.description}</p>

			<div class="text-muted-foreground flex flex-wrap gap-x-2 text-sm">
				{details.map((detail, i) => (
					<>
						{i > 0 && <span aria-hidden="true">·</span>}
						<span>{detail}</span>
					</>
				))}
			</div>

			<div class="flex flex-wrap gap-x-5 gap-y-2 text-sm">
				{links.map((link) => (
					<a
						href={link.href}
						rel="noopener noreferrer"
						target="_blank"
						class="text-primary flex items-center gap-1.5 font-medium hover:underline"
					>
						<Icon icon={link.icon} small />
						{link.label}
					</a>
				))}
			</div>
		</div>

		<div class="flex flex-col gap-5">
			<div class="flex items-baseline justify-between gap-4">
				<h2 class="font-serif text-xl font-bold">Recent posts</h2>
				<a
					href={feed.links.browsePosts}
					class="text-primary flex items-center gap-2 text-sm font-medium whitespace-nowrap hover:underline"
				>
					Browse all
					<Icon icon={ArrowRightIcon} small />
				</a>
			</div>

			{recentPosts.length === 0 ? (
				<p class="text-muted-foreground text-sm">
					No posts have been indexed from this source yet.
				</p>
			) : (
				recentPosts.map((post) => <PostComponent post={post} />)
			)}
		</div>
	</div>
</Layout>
