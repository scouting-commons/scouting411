---
import Layout from "@/components/layout/Layout.astro";
import { feeds } from "@/lib/news/feeds/feed";
---

<Layout title="News Sources">
	<div class="flex w-full max-w-6xl flex-col gap-6 p-8">
		<p class="text-muted-foreground text-sm">
			{feeds.length} official sources, checked for new posts once a day.
		</p>

		<ul class="grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-3">
			{feeds.map((feed) => (
				<li>
					<a
						href={feed.links.overview}
						class="group hover:bg-muted/40 flex h-full gap-4 rounded-lg border p-4"
					>
						<img
							src={feed.coverImageSrc}
							alt=""
							loading="lazy"
							class="bg-card size-14 shrink-0 rounded-md border object-contain p-1.5"
						/>
						<div class="flex min-w-0 flex-col gap-1">
							<span class="text-primary font-serif leading-snug font-bold group-hover:underline">
								{feed.name}
							</span>
							<p class="text-muted-foreground line-clamp-3 text-sm">
								{feed.description}
							</p>
						</div>
					</a>
				</li>
			))}
		</ul>
	</div>
</Layout>
