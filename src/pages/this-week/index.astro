---
import Layout from "@/components/layout/Layout.astro";
import { defaultVisibleFeedSlugs } from "@/lib/news/feeds/types";
import { postsQueryParamsEncoder } from "@/lib/news/query/queryParams";
import { rpc } from "@/rpc/client";

import { faArrowRight } from "@fortawesome/free-solid-svg-icons";
import { FontAwesomeIcon } from "@fortawesome/react-fontawesome";

export const prerender = false;

// each sunday's edition covers the sunday-to-saturday week before it, in utc
// to match the query filter
const edition = new Date();
edition.setUTCDate(edition.getUTCDate() - edition.getUTCDay());
const daysAgo = (days: number) => {
	const date = new Date(edition);
	date.setUTCDate(date.getUTCDate() - days);
	return date;
};
const isoDate = (date: Date) => date.toISOString().slice(0, 10);

const start = daysAgo(7);
const end = daysAgo(1);
const filter = { from: isoDate(start), to: isoDate(end) };

const query = { feeds: defaultVisibleFeedSlugs, filter };

const { posts } = await rpc.news.posts.query({ ...query, paginate: false });

// the newest post with its own photo leads the page, the rest run in a section
// per source, ordered by each source's newest post
const lead = posts.find((post) => post.thumbnail) ?? posts[0];
const sections = [
	...Map.groupBy(
		posts.filter((post) => post !== lead),
		(post) => post.feed.slug,
	).values(),
].map((sectionPosts) => ({ feed: sectionPosts[0]!.feed, posts: sectionPosts }));

// a section is as many columns wide as it has stories, up to three
const sectionColumns = [
	"",
	"lg:grid-cols-1",
	"lg:grid-cols-2",
	"lg:grid-cols-3",
];
const columnCount = (storyCount: number) => Math.min(storyCount, 3);

const sourceCount = new Set(posts.map((post) => post.feed.slug)).size;
const browseHref = `/news/browse?${postsQueryParamsEncoder.encode(query)}`;

const formatDate = (date: Date, options: Intl.DateTimeFormatOptions) =>
	date.toLocaleDateString("en-US", { ...options, timeZone: "UTC" });
const shortDate = (date: Date) =>
	formatDate(date, { month: "long", day: "numeric" });
---

<Layout title="This Week in Scouting">
	<div class="mx-auto flex w-full max-w-6xl flex-col gap-10 p-4 md:p-8">
		<header class="flex flex-col">
			<div class="text-muted-foreground flex flex-wrap justify-between gap-x-4 border-t py-2 text-xs tracking-widest uppercase">
				<span>{formatDate(edition, { dateStyle: "full" })}</span>
				<span>scouting411.org</span>
			</div>
			<h1 class="border-y-4 border-double py-4 text-center font-serif text-4xl font-black tracking-tight md:text-6xl">
				This Week in Scouting
			</h1>
			<div class="text-muted-foreground flex flex-wrap justify-between gap-x-4 border-b py-2 text-xs tracking-widest uppercase">
				<span>
					{shortDate(start)} - {shortDate(end)}
				</span>
				<span>
					{posts.length} stories from {sourceCount} sources
				</span>
			</div>
		</header>

		{lead === undefined ? (
			<p class="text-muted-foreground text-center font-serif italic">
				Nothing was posted this week.
			</p>
		) : (
			<>
				<article class="grid gap-6 md:grid-cols-5">
					{lead.thumbnail && (
						<img
							class="aspect-video w-full object-cover md:col-span-3"
							src={lead.thumbnail}
							alt=""
						/>
					)}
					<div
						class:list={[
							"flex flex-col gap-3",
							lead.thumbnail ? "md:col-span-2" : "md:col-span-5",
						]}
					>
						<a
							href={lead.feed.links.overview}
							class="text-primary text-xs font-bold tracking-widest uppercase hover:underline"
						>
							{lead.feed.name}
						</a>
						<a
							href={lead.url}
							rel="noopener noreferrer"
							target="_blank"
							class="font-serif text-3xl leading-tight font-black wrap-anywhere hyphens-auto hover:underline md:text-4xl"
						>
							{lead.title}
						</a>
						<span class="text-muted-foreground text-sm italic">
							{shortDate(lead.date)}
						</span>
						{lead.description && (
							<p class="font-serif leading-relaxed hyphens-auto first-letter:float-left first-letter:mt-1 first-letter:mr-2 first-letter:text-5xl first-letter:leading-none first-letter:font-black">
								{lead.description}
							</p>
						)}
					</div>
				</article>

				{sections.map((section) => {
					const columns = columnCount(section.posts.length);

					return (
						<section class="border-foreground flex flex-col gap-6 border-t-2 pt-2">
							<div class="flex items-baseline justify-between gap-4">
								<a
									href={section.feed.links.overview}
									class="font-serif text-lg font-bold tracking-wider uppercase hover:underline"
								>
									{section.feed.name}
								</a>
								<span class="text-muted-foreground text-xs tracking-widest whitespace-nowrap uppercase">
									{section.posts.length}{" "}
									{section.posts.length === 1 ? "story" : "stories"}
								</span>
							</div>
							<div
								class:list={[
									"grid gap-y-6 lg:gap-y-8",
									sectionColumns[columns],
								]}
							>
								{section.posts.map((post, index) => (
									<article
										class:list={[
											"flex flex-col gap-3",
											index > 0 && "border-t pt-6 lg:border-t-0 lg:pt-0",
											index % columns > 0 && "lg:border-l",
											// columns split the gap between them as padding so the rule sits midway
											columns > 1 && index % columns > 0 && "lg:pl-4",
											columns > 1 && index % columns < columns - 1 && "lg:pr-4",
											columns === 1 &&
												post.thumbnail &&
												"md:grid md:grid-cols-2 md:gap-8",
										]}
									>
										{post.thumbnail && (
											<img
												class="aspect-video w-full object-cover"
												src={post.thumbnail}
												alt=""
											/>
										)}
										<div class="flex flex-col gap-2">
											<a
												href={post.url}
												rel="noopener noreferrer"
												target="_blank"
												class="font-serif text-lg leading-snug font-bold wrap-anywhere hyphens-auto hover:underline"
											>
												{post.title}
											</a>
											<span class="text-muted-foreground text-xs italic">
												{shortDate(post.date)}
											</span>
											{post.description && (
												<p class="line-clamp-5 font-serif text-sm leading-relaxed hyphens-auto">
													{post.description}
												</p>
											)}
										</div>
									</article>
								))}
							</div>
						</section>
					);
				})}
			</>
		)}

		<a
			href={browseHref}
			class="text-primary flex items-center justify-center gap-2 text-sm font-medium hover:underline"
		>
			Browse this edition's news
			<FontAwesomeIcon icon={faArrowRight} size="sm" />
		</a>
	</div>
</Layout>
