---
import Layout from "@/components/layout/Layout.astro";

// the server itself is served by `src/pages/mcp.ts`
const mcpUrl = new URL("/mcp", Astro.site).href;

const capabilities = [
	{
		title: "Search",
		description:
			"Find ranks, merit badges, adventures, awards, resources, news sources, and site pages by name.",
	},
	{
		title: "News",
		description:
			"Query posts from every official source, filtered by source, keyword, and date.",
	},
	{
		title: "Advancement",
		description:
			"The current official requirements for every rank, merit badge, Cub Scout adventure, and award.",
	},
	{
		title: "Resources",
		description:
			"Official handbooks, tools, and reference sites from the national organization.",
	},
];

const clients = [
	{
		name: "Claude",
		steps:
			"Open Connectors in Claude's settings, choose Add custom connector, and paste the server URL.",
	},
	{
		name: "Claude Code",
		code: `claude mcp add --transport http scouting411 ${mcpUrl}`,
	},
	{
		name: "VS Code",
		steps: "Add to .vscode/mcp.json:",
		code: JSON.stringify(
			{ servers: { scouting411: { type: "http", url: mcpUrl } } },
			null,
			2,
		),
	},
	{
		name: "Cursor",
		steps: "Add to mcp.json:",
		code: JSON.stringify(
			{ mcpServers: { scouting411: { url: mcpUrl } } },
			null,
			2,
		),
	},
];
---

<Layout title="Agent Setup">
	<div class="mx-auto flex w-full max-w-4xl flex-col gap-8 p-8">
		<section class="flex flex-col gap-3">
			<p class="text-sm">
				Scouting411 runs an MCP server, so an AI assistant can look things up
				here directly instead of relying on memory or web search. MCP (the Model
				Context Protocol) is an open standard for connecting assistants to
				outside tools and data. It's free, needs no account or API key, and
				serves the same first-party data as this site, refreshed daily.
			</p>

			<div class="border-primary/30 bg-primary/5 flex flex-col gap-2 rounded-lg border p-4 px-5">
				<div class="font-serif font-bold">Server URL</div>
				<code class="bg-background w-fit rounded border px-2 py-1 font-mono text-sm wrap-anywhere select-all">
					{mcpUrl}
				</code>
				<p class="text-muted-foreground text-sm">
					A remote MCP server over Streamable HTTP. Add it to any client that
					supports remote servers.
				</p>
			</div>
		</section>

		<section class="flex flex-col gap-4">
			<h2 class="font-serif text-xl font-bold">What it can do</h2>
			<ul class="grid grid-cols-1 gap-4 sm:grid-cols-2">
				{capabilities.map((capability) => (
					<li class="bg-card flex flex-col gap-1 rounded-lg border p-4">
						<span class="font-serif font-bold">{capability.title}</span>
						<span class="text-muted-foreground text-sm">
							{capability.description}
						</span>
					</li>
				))}
			</ul>
			<p class="text-muted-foreground text-sm">
				It covers national, first-party material only — not council or unit
				content, third-party commentary, or retail.
			</p>
		</section>

		<section class="flex flex-col gap-4">
			<h2 class="font-serif text-xl font-bold">Setup</h2>
			<div class="flex flex-col gap-5">
				{clients.map((client) => (
					<div class="flex flex-col gap-2">
						<h3 class="font-semibold">{client.name}</h3>
						{client.steps && <p class="text-sm">{client.steps}</p>}
						{client.code && <pre class="bg-muted overflow-x-auto rounded-md p-3 font-mono text-xs"><code>{client.code}</code></pre>}
					</div>
				))}
			</div>
			<p class="text-muted-foreground text-sm">
				Client menus change often; if these steps are out of date, check your
				client's documentation for adding a remote MCP server.
			</p>
		</section>

		<section class="flex flex-col gap-3">
			<h2 class="font-serif text-xl font-bold">Good to know</h2>
			<ul class="flex flex-col gap-1.5 text-sm">
				<li class="flex gap-2">
					<span class="text-muted-foreground">&bull;</span>
					Data is refreshed once a day, so it may be up to 24 hours behind the
					original sources.
				</li>
				<li class="flex gap-2">
					<span class="text-muted-foreground">&bull;</span>
					The server's tools are still evolving and may change without notice.
				</li>
				<li class="flex gap-2">
					<span class="text-muted-foreground">&bull;</span>
					Scouting411 is not affiliated with Scouting America. Assistants should
					cite the original source, which every result links to.
				</li>
			</ul>
		</section>
	</div>
</Layout>
