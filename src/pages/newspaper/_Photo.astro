---
interface Props {
	src: string;
	/**
	 * `box` fits the photo inside a fixed 16:9 box. `capped` shows it at its
	 * natural height, up to a 3:2 box that a taller photo is fit inside
	 */
	fit: "box" | "capped";
	class?: string;
}

const { src, fit, class: className } = Astro.props;
---

{/* the photo is never cropped. a blurred copy of it fills whatever the box leaves empty */}
<div
	class:list={[
		"@container relative overflow-hidden",
		fit === "box" && "aspect-video",
		className,
	]}
>
	<img
		class="absolute inset-0 size-full scale-110 object-cover opacity-60 blur-2xl"
		src={src}
		alt=""
		aria-hidden="true"
	/>
	<img
		class:list={[
			"relative w-full object-contain",
			fit === "box" ? "h-full" : "h-auto max-h-[66.667cqw]",
		]}
		src={src}
		alt=""
	/>
</div>
