---
import Layout from "@/components/layout/Layout.astro";
import { PostComponent } from "@/components/react/post";
import { tags } from "@/lib/tags/tag";
import { rpc } from "@/rpc/client";
import { ArrowRightIcon } from "lucide-react";
import { Icon } from "@/components/react/icon";

export const prerender = false;

const { slug } = Astro.params;
const tag = tags.find((tag) => tag.slug === slug);

if (!tag) {
	return new Response(null, { status: 404 });
}

// an empty feeds query means every feed, so a tag without sources shows no posts
const { posts, pagination } = tag.newsSources.length
	? await rpc.news.posts.query({
			feeds: tag.newsSources,
			paginate: {
				maxPageSize: 8,
				page: 1,
			},
		})
	: { posts: [], pagination: undefined };

const [featuredPost, ...recentPosts] = posts;

const resources = await rpc.resources.query({ tags: [tag.slug] });

/** the tag's color mixed toward transparent. tags without a color get a neutral gray */
const tint = (percent: number) =>
	`color-mix(in oklab, ${tag.color ?? "var(--muted-foreground)"} ${percent}%, transparent)`;

const formatDate = (date: Date) =>
	date.toLocaleDateString("en-US", {
		year: "numeric",
		month: "long",
		day: "numeric",
	});
---

<Layout title={tag.name + " Hub"}>
	<div
		class="px-8 py-12 lg:pt-16 lg:pb-20"
		style={{
			backgroundColor: tint(20),
		}}
	>
		<div class="mx-auto flex max-w-6xl flex-col gap-3">
			<h1 class="font-serif text-4xl font-bold wrap-anywhere hyphens-auto">
				{tag.name} Hub
			</h1>
			<p class="text-muted-foreground max-w-2xl">{tag.description}</p>
		</div>
	</div>

	<div class="mx-auto grid w-full max-w-6xl grid-cols-1 gap-8 p-8 lg:grid-cols-[1fr_20rem]">
		<div class="flex min-w-0 flex-col gap-5">
			<div class="flex items-center justify-between gap-4 border-b pb-2">
				<h2 class="font-serif text-xl font-bold">Latest news</h2>
				{tag.links.browsePosts && pagination && (
					<a
						href={tag.links.browsePosts}
						class="text-primary flex items-center gap-2 text-sm font-medium whitespace-nowrap hover:underline"
					>
						All {Intl.NumberFormat().format(pagination.totalItems)} in Browse
						<Icon icon={ArrowRightIcon} />
					</a>
				)}
			</div>

			{featuredPost ? (
				<div
					class="@container mb-3 rounded-xl border p-5 shadow-sm @xl:p-7"
					style={{
						backgroundColor: tint(8),
						borderColor: tint(35),
					}}
				>
					<div class="flex flex-col gap-5 @xl:flex-row @xl:items-center @xl:gap-8">
						<img
							class="aspect-video w-full rounded-lg border object-cover @xl:aspect-4/3 @xl:w-1/3 @xl:shrink-0"
							src={featuredPost.thumbnail ?? featuredPost.feed.coverImageSrc}
						/>
						<div class="flex min-w-0 flex-col items-start gap-4">
							<span class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs">
								<a
									href={featuredPost.feed.links.overview}
									class="hover:underline"
								>
									{featuredPost.feed.name}
								</a>
								<span class="font-bold">&middot;</span>
								<span class="whitespace-nowrap">
									{formatDate(featuredPost.date)}
								</span>
							</span>
							<a
								href={featuredPost.url}
								rel="noopener noreferrer"
								target="_blank"
								class="text-primary font-serif text-2xl font-bold wrap-anywhere @xl:text-3xl hyphens-auto hover:underline"
							>
								{featuredPost.title}
							</a>
							<p class="line-clamp-4 wrap-anywhere hyphens-auto">
								{featuredPost.description || "No excerpt available."}
							</p>
						</div>
					</div>
				</div>
			) : (
				<div class="text-muted-foreground rounded-lg border p-6 text-sm">
					No posts have been indexed for this hub yet.
				</div>
			)}

			{recentPosts.map((post) => (
				<PostComponent post={post} />
			))}
		</div>

		<aside class="lg:-mt-20">
			<div class="bg-card flex flex-col gap-3 rounded-lg border p-5 shadow-sm lg:sticky lg:top-17">
				<div class="flex items-center justify-between gap-4">
					<h2 class="font-serif text-xl font-bold">Resources</h2>
					{resources.length > 0 && (
						<a
							href={tag.links.browseResources}
							class="text-primary flex items-center gap-2 text-sm font-medium whitespace-nowrap hover:underline"
						>
							All {resources.length}
							<Icon icon={ArrowRightIcon} />
						</a>
					)}
				</div>
				{resources.length > 0 ? (
					<ul class="flex flex-col gap-3">
						{resources.map((resource) => (
							<li class="flex flex-col gap-0.5">
								<a
									href={resource.url}
									rel="noopener noreferrer"
									target="_blank"
									class="text-primary font-medium hover:underline"
								>
									{resource.title}
								</a>
								<p class="text-muted-foreground line-clamp-2 text-sm">
									{resource.description}
								</p>
							</li>
						))}
					</ul>
				) : (
					<p class="text-muted-foreground text-sm">
						No resources are tagged for this hub yet.
					</p>
				)}
			</div>
		</aside>
	</div>
</Layout>
