---
import Layout from "@/components/layout/Layout.astro";
import Requirements from "@/components/advancement/Requirements.astro";
import { rpc } from "@/rpc/client";
import { safe } from "@orpc/client";
import { ArrowLeftIcon, ExternalLinkIcon } from "lucide-react";
import { Icon } from "@/components/react/icon";

export const prerender = false;

const { slug = "" } = Astro.params;

const { data: meritBadge } = await safe(
	rpc.advancement.meritBadges.get({ slug }),
);

if (!meritBadge) {
	return new Response(null, { status: 404 });
}

const versionEffective = meritBadge.versionEffective
	? new Date(`${meritBadge.versionEffective}T00:00:00`).toLocaleDateString(
			"en-US",
			{ year: "numeric", month: "long", day: "numeric" },
		)
	: undefined;
---

<Layout title={`${meritBadge.name} Merit Badge`}>
	<div class="mx-auto flex w-full max-w-4xl flex-col gap-8 p-8">
		<a
			href="/advancement/merit-badges"
			class="text-primary flex items-center gap-2 self-start text-sm font-medium hover:underline"
		>
			<Icon icon={ArrowLeftIcon} />
			All merit badges
		</a>

		<div class="flex flex-col items-start gap-5 sm:flex-row sm:items-center">
			<img
				src={meritBadge.images.large}
				alt={`${meritBadge.name} merit badge`}
				width="200"
				height="200"
				class="size-32 shrink-0"
			/>

			<div class="flex min-w-0 flex-col items-start gap-2">
				<h1 class="font-serif text-3xl font-bold wrap-anywhere hyphens-auto">
					{meritBadge.name}
				</h1>
				{meritBadge.eagleRequired && (
					<div class="text-muted-foreground text-sm">Required for Eagle</div>
				)}
				<div class="flex flex-wrap gap-2 text-xs">
					{meritBadge.categories.map((category) => (
						<span class="bg-muted rounded-full px-2.5 py-0.5 font-medium">
							{category.name}
						</span>
					))}
				</div>
				<div class="text-muted-foreground text-sm">
					{versionEffective
						? `${meritBadge.version} requirements, effective ${versionEffective}`
						: `${meritBadge.version} requirements`}
				</div>
				<a
					href={meritBadge.url}
					rel="noopener noreferrer"
					target="_blank"
					class="text-primary flex items-center gap-2 text-sm font-medium hover:underline"
				>
					View on scouting.org
					<Icon icon={ExternalLinkIcon} />
				</a>
			</div>
		</div>

		<Requirements requirements={meritBadge.requirements} />
	</div>
</Layout>
