---
import Layout from "@/components/layout/Layout.astro";
import { meritBadgePath } from "@/lib/advancement/meritBadges/types";
import { rpc } from "@/rpc/client";

import { faStar, faTableCells } from "@fortawesome/free-solid-svg-icons";
import { FontAwesomeIcon } from "@fortawesome/react-fontawesome";

export const prerender = false;

const meritBadges = (await rpc.advancement.meritBadges.list()).toSorted(
	(a, b) => a.name.localeCompare(b.name),
);

// every badge is shown unless the eagle-required tab is asked for
const tabs = [
	{
		label: "All badges",
		icon: faTableCells,
		href: "/advancement/merit-badges",
		eagleOnly: false,
	},
	{
		label: "Eagle required",
		icon: faStar,
		href: "/advancement/merit-badges?filter=eagle-required",
		eagleOnly: true,
	},
];
const eagleOnly = Astro.url.searchParams.get("filter") === "eagle-required";
const shownBadges = eagleOnly
	? meritBadges.filter((badge) => badge.eagleRequired)
	: meritBadges;
---

<Layout title="Merit Badges">
	<div class="mx-auto flex w-full max-w-6xl flex-col gap-10 p-8">
		<p class="border-primary/30 bg-primary/5 rounded-lg border p-4 px-5 text-sm">
			These requirements are pulled daily from Scouting America's national
			advancement data, but the official source can always be browsed directly
			at{" "}
			<a
				href="https://www.scouting.org/skills/merit-badges/all/"
				rel="noopener noreferrer"
				target="_blank"
				class="text-primary wrap-anywhere hyphens-auto hover:underline"
			>
				scouting.org
			</a>
			. If something looks wrong here,{" "}
			<a
				href="https://github.com/scouting-commons/scouting411/issues/new/choose"
				rel="noopener noreferrer"
				target="_blank"
				class="text-primary wrap-anywhere hyphens-auto hover:underline"
			>
				report an issue
			</a>
			.
		</p>

		{meritBadges.length === 0 && (
			<div class="text-muted-foreground rounded-lg border p-6 text-sm">
				No merit badges have been indexed yet.
			</div>
		)}

		{meritBadges.length > 0 && (
			<nav class="flex gap-6 border-b text-sm" aria-label="Filter">
				{tabs.map((tab) => (
					<a
						href={tab.href}
						aria-current={tab.eagleOnly === eagleOnly ? "page" : undefined}
						class="text-muted-foreground hover:text-foreground aria-[current=page]:border-primary aria-[current=page]:text-foreground -mb-px flex items-center gap-1.5 border-b-2 border-transparent pb-2 font-medium [&_svg]:size-4"
					>
						<FontAwesomeIcon icon={tab.icon} />
						{tab.label}
					</a>
				))}
			</nav>
		)}

		<div class="grid auto-rows-fr grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6">
			{shownBadges.map((badge) => (
				<a
					href={meritBadgePath(badge.slug)}
					class:list={[
						"hover:border-primary group flex flex-col items-center gap-2 rounded-lg border p-4 text-center transition-colors",
						badge.eagleRequired && "border-primary/40 bg-primary/5",
					]}
				>
					<img
						src={badge.images.medium}
						alt=""
						width="100"
						height="100"
						loading="lazy"
						class="size-20"
					/>
					<span class="group-hover:text-primary font-serif text-sm font-bold">
						{badge.eagleRequired && (
							<>
								<FontAwesomeIcon icon={faStar} className="text-primary mr-1" />
								<span class="sr-only">Eagle required:</span>
							</>
						)}
						{badge.name}
					</span>
				</a>
			))}
		</div>
	</div>
</Layout>
